# Шаблон: раскомментировать и заполнить нужные переменные. Пустое значение (KEY=) перебивает
# значение по умолчанию в коде — поэтому неиспользуемые строки оставить закомментированными.
#DATABASE_URL=
#LLM_PROVIDER=
#PERPLEXITY_API_KEY=
#SECRET_KEY=
#USERS=
#INBOX_1C=
#DATA_DIR=
#TZ=
#SCRAPE_INTERVAL_H=
#BRIEFING_HOUR=
