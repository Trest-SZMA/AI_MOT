[Unit]
Description=Ночная пересборка отчёта по реализации (данные из SQL «Extractor»)
Documentation=file:/opt/metoptorg-realizaciya/СОСТОЯНИЕ_И_ПЕРЕДАЧА.md

[Timer]
# ⚠️ 04:00, А НЕ РАНЬШЕ. В час ночи в «Extractor» стартует обновление всех баз
# из 1С; если начать пересборку в это же время, мы прочитаем таблицы наполовину
# обновлёнными и цифры будут смесью вчерашних и сегодняшних — причём молча, без
# единой ошибки. Три часа запаса на выгрузку 1С.
OnCalendar=*-*-* 04:00:00
# Пропущенный запуск (сервер был выключен) отрабатывается сразу после старта:
# лучше собрать с опозданием, чем не собрать вовсе.
Persistent=true
# Разброс до 5 минут: на машине живут пять сервисов, и одновременный старт
# тяжёлых задач ей не нужен.
RandomizedDelaySec=300

[Install]
WantedBy=timers.target
