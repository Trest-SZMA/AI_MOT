# Настройки docker compose. Скопировать в .env (это делает deploy/docker/setup.sh).
HOST_IP=192.168.1.10          # адрес сервера, по которому ходят пользователи (для ссылок портала)
TZ=Asia/Yekaterinburg
DATA_ROOT=./data              # куда класть данные всех сервисов (можно вынести на отдельный диск)
POSTGRES_PASSWORD=            # пароль базы metallompro (генерирует setup.sh)
